msgid ""
"Error! The new paths are not loading correctly. Clear all cache and try "
"again."
msgstr ""
"Eroare! Noile căi nu se încarcă corect. Golește toate cache-urile și "
"încearcă din nou."

#: controllers/SecurityCheck.php:832 controllers/SecurityCheck.php:891
#: controllers/SecurityCheck.php:968 controllers/SecurityCheck.php:990
#: controllers/SecurityCheck.php:1041 controllers/SecurityCheck.php:1061
#: controllers/SecurityCheck.php:1089
