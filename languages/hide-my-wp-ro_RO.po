msgstr "Salvat! Poți rula testul din nou."

#: controllers/SecurityCheck.php:834
msgid "Learn How"
msgstr "Află cum"

#: controllers/SecurityCheck.php:848 controllers/SecurityCheck.php:864
#: controllers/SecurityCheck.php:903 controllers/SecurityCheck.php:951
#: controllers/SecurityCheck.php:974 controllers/SecurityCheck.php:997
msgid "Could not fix it. You need to change it manually."
msgstr "Nu s-a putut rezolva. Trebuie să-l schimbi singur."

#: controllers/SecurityCheck.php:943
msgid "Saved! Reload the page."
msgstr "Salvat! Reîncarcă pagina."

#: controllers/SecurityCheck.php:1006
msgid "Invalid username."
msgstr "Nume de utilizator invalid."

#: controllers/SecurityCheck.php:1013
msgid "A user already exists with that username."
msgstr "Există deja un utilizator cu acest nume de utilizator."

#: controllers/SecurityCheck.php:1080
msgid "Saved! This task will be ignored on future tests."
