msgstr ""
"Sepenuhnya kompatibel dengan plugin cache Autoptimize. Bekerja terbaik "
"dengan opsi Optimalkan/Gabungkan file CSS dan JS."

#: controllers/Overview.php:477
msgid "Hummingbird"
msgstr "Hummingbird"

#: controllers/Overview.php:478
